# Salin menjadi .env.local (jangan di-commit).
# K-01: tampilkan konten kesehatan draf berlabel "belum ditinjau" (true/false).
NEXT_PUBLIC_SHOW_DRAFT_CONTENT=true

# Supabase (Project Settings → API). Publishable key aman untuk browser; JANGAN taruh secret/service role di sini.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
