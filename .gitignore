# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# =========================
# Node.js / Next.js
# =========================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

/coverage
/.next/
/out/
/build
.vercel
*.tsbuildinfo
next-env.d.ts

# =========================
# Environment variables & secrets
# =========================
.env
.env.*
!.env.example
.env.local
backend/.env
service-account*.json
*-credentials.json
credentials.json
*.pem
*.key

# =========================
# Python
# =========================
.venv/
venv/
backend/.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# =========================
# Python build artifacts
# =========================
build/
dist/

# =========================
# Vector databases / local data
# =========================
backend/data/chroma/
chroma_db/
data/*
!data/.gitkeep

# =========================
# Logs & temporary files
# =========================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
backend/backend.log
tmp/

# =========================
# IDE / OS
# =========================
.vscode/
.idea/
.DS_Store
Thumbs.db
.env*
!.env.example
